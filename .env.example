# Copy to .env.local (development) or .env.production (server) and fill in.
# Keep ONLY these variables in production — no Supabase service-role/anon keys
# (the site doesn't use them; see audit finding SEC-06).

# Read-only role (db/readonly-role.sql) through the Supabase TRANSACTION pooler
# (port 6543). Do NOT use the session pooler (5432): it caps the whole database
# at 15 clients shared with the agents' app, and builds/serverless functions hit
# "EMAXCONNSESSION max clients reached". pgbouncer=true disables prepared
# statements, as transaction pooling requires.
#   Vercel (serverless):        ...?pgbouncer=true&connection_limit=1
#   AWS (one Node process):     ...?pgbouncer=true&connection_limit=5&pool_timeout=10
DATABASE_URL="postgresql://web_readonly.<project_ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10"

# UCCI organization id in the shared database.
ORGANIZATION_ID=""

# Canonical origin, no trailing slash. Used by sitemap, robots, canonical and
# Open Graph URLs. Set it per environment (staging must use its own URL).
NEXT_PUBLIC_SITE_URL="https://www.uccipropiedades.com"

# Google Analytics 4 measurement id (G-XXXXXXX). Empty = analytics disabled.
NEXT_PUBLIC_GA_ID=""

# Supabase project host serving property photos (next/image allowlist).
SUPABASE_STORAGE_HOST="ozkgdwemrszodajnqvcz.supabase.co"

# --- Caddy (deploy/caddy) ---
DOMAIN="www.uccipropiedades.com"
APEX_DOMAIN="uccipropiedades.com"
ACME_EMAIL="info@uccipropiedades.com"
