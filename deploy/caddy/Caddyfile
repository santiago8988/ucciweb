# Reverse proxy in front of the Next.js container: automatic HTTPS (Let's
# Encrypt), compression, per-IP rate limiting and unbuffered streaming.
# Security headers (CSP, HSTS, etc.) are set by the app in next.config.ts.
{
	order rate_limit before reverse_proxy
	email {$ACME_EMAIL}
}

# Apex → www (canonical host).
{$APEX_DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Pages only: /_next/* (static files and optimized images) is
	# served from cache and one page view triggers dozens of those requests.
	# 10 page req/s per IP leaves room for visitors sharing an IP (mobile
	# carriers' CGNAT, offices) and still blunts scrapers/floods.
	@pages not path /_next/*
	rate_limit @pages {
		zone per_ip {
			key {remote_host}
			events 600
			window 1m
		}
	}

	reverse_proxy web:3000 {
		# Next.js streams HTML (loading states); don't buffer responses.
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}
